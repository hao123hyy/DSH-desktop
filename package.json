{
  "name": "dsh-desktop",
  "productName": "DSH桌面版",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面客户端：一键启动 Web UI，无需命令行。",
  "main": "main.js",
  "author": "DSH Desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "make": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make.ps1",
    "prepare-payload": "node scripts/prepare-payload.js",
    "postinstall": "node scripts/prepare-payload.js"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.deepseek.dsh-desktop",
    "productName": "DSH桌面版",
    "asar": true,
    "compression": "normal",
    "files": [
      "main.js",
      "updater.js",
      "loading.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "artifactName": "DSH桌面版-${version}-portable.exe"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "semver": "^7.8.5",
    "tar": "^7.5.22"
  }
}
